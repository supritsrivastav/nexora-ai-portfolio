# Used by docker compose for local development. Replace placeholders locally.
GOOGLE_API_KEY=replace_with_your_google_ai_api_key
DB_NAME=deskpilot_db
DB_USER=YOUR_DB_USERNAME
DB_PASSWORD=replace_with_a_local_database_password
# Docker Compose runs multiple backend workers and therefore uses shared Redis.
RATE_LIMIT_BACKEND=redis
WEB_CONCURRENCY=2
REDIS_URL=redis://redis:6379/0
